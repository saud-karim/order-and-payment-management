APP_NAME="Order Payment API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite is used for local development and automated tests.
# Note: SQLite does not enforce the same row-level locking semantics as MySQL/PostgreSQL.
# Payment concurrency tests in later phases should be validated against a production-like DB.
DB_CONNECTION=sqlite
# DB_DATABASE is optional for SQLite; defaults to database/database.sqlite

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# JWT (php-open-source-saver/jwt-auth). Run: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0
JWT_ALGO=HS256

AUTH_GUARD=api

ORDER_DEFAULT_CURRENCY=USD

PAYMENT_GATEWAY_CREDIT_CARD_ENABLED=true
PAYMENT_GATEWAY_PAYPAL_ENABLED=true
PAYMENT_SIM_DECLINE_SUFFIX=-DECLINE
PAYMENT_SIM_UNAVAILABLE_SUFFIX=-TIMEOUT
PAYMENT_SIM_ERROR_SUFFIX=-ERROR
